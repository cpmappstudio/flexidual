# This environment variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOYMENT=dev:aaa-bbb-111 # team: cpm-studio, project: cpm-studio

NEXT_PUBLIC_CONVEX_URL=https://aaa-bbb-111.convex.cloud

NEXT_PUBLIC_CONVEX_SITE_URL=https://aaa-bbb-111.convex.site

# Root domain used by the frontend for wildcard tenant routing.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Base URL used by backend invitation links.
APP_BASE_URL=http://localhost:3000

# Local-only bootstrap for generating the first platform superadmin invite.
ENABLE_DEV_BOOTSTRAP=false

# Optional password reset email configuration for Convex Auth Password provider.
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxx
AUTH_EMAIL=CPM Studio <no-reply@example.com>

# Optional GitHub REST API configuration for the changelog page.
# Set a token for private repositories or higher API rate limits.
GITHUB_CHANGELOG_REPOSITORY=cpmappstudio/cpm-studio
GITHUB_CHANGELOG_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

SETUP_SCRIPT_RAN=1
